# Environment Configuration Example
# Copy this file to .env for local development or set these variables in Render dashboard for production

# Server Environment
NODE_ENV=production
PORT=10000

# Frontend URL (Exact production origin for CORS and cookies, no trailing slash)
CLIENT_URL=https://campus-stationery-management-system.vercel.app

# Database (MongoDB Atlas connection string)
MONGO_URI=mongodb+srv://<USERNAME>:<PASSWORD>@campus-stationery-manag.syuuf5n.mongodb.net/campus_stationery?retryWrites=true&w=majority

# JWT Authentication
JWT_SECRET=your_jwt_strong_secret_key_here
JWT_EXPIRES_IN=7d
JWT_COOKIE_NAME=cs_token

# Razorpay Payment Gateway (Test mode keys)
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_secret
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret

# Brevo Email API (Transactional HTTPS API)
BREVO_API_KEY=your_brevo_api_key_here
BREVO_SENDER_EMAIL=your_verified_sender_email@domain.com
BREVO_SENDER_NAME=Campus Stationery Shop

# Rate Limiting
RATE_LIMIT_WINDOW_MIN=15
RATE_LIMIT_MAX=100
