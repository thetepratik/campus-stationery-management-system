# Frontend Environment Variables (.env)
# For local development with Vite dev proxy (default):
# VITE_API_URL can be omitted or set to:
# VITE_API_URL=http://localhost:5000/api

# For production deployment on Vercel:
# Set this environment variable in your Vercel Project Settings -> Environment Variables:
# VITE_API_URL=https://campus-stationery-api.onrender.com/api
